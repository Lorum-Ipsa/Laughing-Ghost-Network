# Example local development settings. Never commit real passwords or private keys.
POCKETBASE_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=replace-with-local-admin@example.invalid
PB_SUPERUSER_PASSWORD=replace-with-unique-local-secret
LGN_APP_URL=http://localhost:3000
PB_ENCRYPTION_KEY=replace-with-unique-long-local-key

# Supabase is now used for the normal registration and member session.
# Codespaces dev mode has a PUBLIC publishable-key fallback for lgn-development.
# Always set an environment-specific public project URL/key for deployments.
VITE_LGN_SUPABASE_URL=https://oatdfrnytmliunauxqyd.supabase.co
VITE_LGN_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Do not enter service_role, secret keys or SMTP credentials in VITE_ variables.
